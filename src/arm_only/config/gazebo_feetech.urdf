<gazebo reference="realsense_link">

  <!-- RGB camera -->
  <sensor type="camera" name="realsense_rgb">
    <update_rate>30</update_rate>

    <camera>
      <horizontal_fov>1.396</horizontal_fov>

      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>

      <clip>
        <near>0.1</near>
        <far>10</far>
      </clip>
    </camera>

    <plugin name="rgb_camera_controller"
            filename="libgazebo_ros_camera.so">

      <cameraName>realsense</cameraName>
      <imageTopicName>rgb/image_raw</imageTopicName>
      <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
      <frameName>realsense_optical_frame</frameName>

      <updateRate>30.0</updateRate>
      <alwaysOn>true</alwaysOn>

    </plugin>

  </sensor>

  <!-- Depth camera -->
  <sensor type="depth" name="realsense_depth">
    <update_rate>30</update_rate>

    <camera>
      <horizontal_fov>1.396</horizontal_fov>

      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>

      <clip>
        <near>0.1</near>
        <far>10</far>
      </clip>
    </camera>

    <plugin name="depth_camera_controller"
            filename="libgazebo_ros_depth_camera.so">

      <cameraName>realsense</cameraName>
      <depthImageTopicName>depth/image_raw</depthImageTopicName>
      <pointCloudTopicName>points</pointCloudTopicName>
      <frameName>realsense_optical_frame</frameName>

      <updateRate>30.0</updateRate>
      <alwaysOn>true</alwaysOn>

    </plugin>

  </sensor>

</gazebo>
</robot>

